/* GLKVM Screen Guard — dark theme (Fusion + QSS) */

QWidget {
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 9pt;
    color: #e6e6e6;
}

QMainWindow, QDialog {
    background: #1e1e1e;
}

QMenuBar {
    background: #252526;
    border-bottom: 1px solid #3a3a3a;
}
QMenuBar::item {
    padding: 4px 10px;
    background: transparent;
}
QMenuBar::item:selected {
    background: #3a3a3a;
}
QMenu {
    background: #252526;
    border: 1px solid #3a3a3a;
}
QMenu::item {
    padding: 4px 22px 4px 18px;
}
QMenu::item:selected {
    background: #094771;
}

QTabWidget::pane {
    border: 1px solid #3a3a3a;
    background: #1e1e1e;
    top: -1px;
}
QTabBar::tab {
    background: #252526;
    border: 1px solid #3a3a3a;
    border-bottom: none;
    padding: 6px 16px;
    margin-right: 2px;
    color: #b0b0b0;
}
QTabBar::tab:selected {
    background: #1e1e1e;
    color: #4cc2ff;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    background: #2d2d30;
}

QGroupBox {
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    margin-top: 16px;
    padding-top: 10px;
    background: #252526;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #cfcfcf;
    font-weight: 600;
}

QLineEdit, QSpinBox, QComboBox {
    border: 1px solid #3f3f46;
    border-radius: 3px;
    padding: 3px 6px;
    background: #2d2d30;
    color: #e6e6e6;
    selection-background-color: #094771;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #4cc2ff;
}
QComboBox QAbstractItemView {
    background: #2d2d30;
    border: 1px solid #3f3f46;
    selection-background-color: #094771;
}

QPushButton {
    border: 1px solid #3f3f46;
    border-radius: 3px;
    padding: 4px 14px;
    background: #2d2d30;
    color: #e6e6e6;
    min-height: 20px;
}
QPushButton:hover {
    background: #3a3a3d;
}
QPushButton:pressed {
    background: #45454a;
}
QPushButton:disabled {
    color: #7a7a7a;
    background: #262628;
    border-color: #333333;
}


QTableWidget {
    border: 1px solid #3a3a3a;
    gridline-color: #333333;
    background: #252526;
    alternate-background-color: #2a2a2c;
    color: #e6e6e6;
}
QHeaderView::section {
    background: #2d2d30;
    border: none;
    border-bottom: 1px solid #3a3a3a;
    padding: 5px 6px;
    color: #cfcfcf;
    font-weight: 600;
}
QTableWidget::item:selected {
    background: #094771;
    color: #ffffff;
}

QPlainTextEdit {
    border: 1px solid #3a3a3a;
    background: #1b1b1b;
    color: #d4d4d4;
}

QStatusBar {
    background: #252526;
    border-top: 1px solid #3a3a3a;
    color: #b0b0b0;
}

QToolTip {
    background: #2d2d30;
    color: #e6e6e6;
    border: 1px solid #555555;
    padding: 4px;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background: #1e1e1e;
    border: none;
}
QScrollBar:vertical {
    background: #252526;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #45454a;
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar:horizontal {
    background: #252526;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #45454a;
    min-width: 20px;
    border-radius: 5px;
    margin: 2px;
}
