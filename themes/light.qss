/* GLKVM Screen Guard — light theme (Fusion + QSS) */

QWidget {
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 9pt;
    color: #1b1b1b;
}

QMainWindow, QDialog {
    background: #f3f3f3;
}

QMenuBar {
    background: #f7f7f7;
    border-bottom: 1px solid #e0e0e0;
}
QMenuBar::item {
    padding: 4px 10px;
    background: transparent;
}
QMenuBar::item:selected {
    background: #e8e8e8;
}
QMenu {
    background: #ffffff;
    border: 1px solid #d0d0d0;
}
QMenu::item {
    padding: 4px 22px 4px 18px;
}
QMenu::item:selected {
    background: #e8f1fb;
}

QTabWidget::pane {
    border: 1px solid #dcdcdc;
    background: #fafafa;
    top: -1px;
}
QTabBar::tab {
    background: #f0f0f0;
    border: 1px solid #dcdcdc;
    border-bottom: none;
    padding: 6px 16px;
    margin-right: 2px;
    color: #444444;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #0067c0;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    background: #f7f7f7;
}

QGroupBox {
    border: 1px solid #dcdcdc;
    border-radius: 4px;
    margin-top: 16px;
    padding-top: 10px;
    background: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #444444;
    font-weight: 600;
}

QLineEdit, QSpinBox, QComboBox {
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    padding: 3px 6px;
    background: #ffffff;
    selection-background-color: #cce4f7;
    selection-color: #1b1b1b;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #0067c0;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #c8c8c8;
    selection-background-color: #e8f1fb;
}

QPushButton {
    border: 1px solid #c8c8c8;
    border-radius: 3px;
    padding: 4px 14px;
    background: #fbfbfb;
    min-height: 20px;
}
QPushButton:hover {
    background: #f0f0f0;
}
QPushButton:pressed {
    background: #e5e5e5;
}
QPushButton:disabled {
    color: #a0a0a0;
    background: #f5f5f5;
    border-color: #e3e3e3;
}


QTableWidget {
    border: 1px solid #dcdcdc;
    gridline-color: #eeeeee;
    background: #ffffff;
    alternate-background-color: #fafafa;
}
QHeaderView::section {
    background: #f5f5f5;
    border: none;
    border-bottom: 1px solid #dcdcdc;
    padding: 5px 6px;
    font-weight: 600;
}
QTableWidget::item:selected {
    background: #d9ecfb;
    color: #1b1b1b;
}

QPlainTextEdit {
    border: 1px solid #dcdcdc;
    background: #ffffff;
    color: #333333;
}

QStatusBar {
    background: #f7f7f7;
    border-top: 1px solid #e0e0e0;
    color: #555555;
}

QToolTip {
    background: #ffffe0;
    color: #1b1b1b;
    border: 1px solid #c8c8c8;
    padding: 4px;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background: #fafafa;
    border: none;
}
QScrollBar:vertical {
    background: #f0f0f0;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c8c8c8;
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar:horizontal {
    background: #f0f0f0;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #c8c8c8;
    min-width: 20px;
    border-radius: 5px;
    margin: 2px;
}
